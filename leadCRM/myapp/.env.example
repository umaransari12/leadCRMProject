# Local development only: where the backend runs. Leave unset to use http://localhost:5000.
# Production (Vercel) uses .env.production (empty = same-origin /api).
#REACT_APP_API_URL=http://localhost:5000

# Optional: enables the Google button. Same Google OAuth web client ID as GOOGLE_CLIENT_ID on the server.
# It is baked into the build, so changing it requires a rebuild/redeploy.
#REACT_APP_GOOGLE_CLIENT_ID=
