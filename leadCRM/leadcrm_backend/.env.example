# Copy to .env for local development. Never commit the real .env.
PORT=5000
# MongoDB connection string for YOUR OWN database (use a separate database for any public demo).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
# Random string, at least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional: extra browser origins allowed to call the API (comma separated). localhost:3000 is allowed in development automatically.
CLIENT_URL=
# Local development only, opt-in: override Node's DNS servers if mongodb+srv:// fails with "querySrv ECONNREFUSED"
# (dns.getServers() showing 127.0.0.1). Comma separated. Leave commented out / remove to disable. Never set on Vercel.
# LOCAL_DNS_SERVERS=8.8.8.8,8.8.4.4
